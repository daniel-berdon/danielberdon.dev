---
import { getCollection } from 'astro:content';
import ProjectCasePage from '../../../components/pages/ProjectCasePage.astro';

export async function getStaticPaths() {
  // Inglés: los proyectos bajo en/ (id «en/slug»); la ruta lleva solo el slug
  const proyectos = (
    await getCollection('proyectos', ({ id }) => id.startsWith('en/'))
  ).sort((a, b) => a.data.orden - b.data.orden);
  return proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.id.split('/').pop() },
    props: {
      proyecto,
      prev: proyectos[i - 1] ?? null,
      next: proyectos[i + 1] ?? null,
    },
  }));
}

const { proyecto, prev, next } = Astro.props;
---

<ProjectCasePage proyecto={proyecto} prev={prev} next={next} lang="en" />
