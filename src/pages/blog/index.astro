---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { useTranslations, formatDate } from '../../i18n/ui';

const t = useTranslations();

const posts = (await getCollection('blog', ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${site.url}/blog#blog`,
  url: `${site.url}/blog`,
  name: `${site.name} — Blog`,
  description: site.blogDescription,
  inLanguage: 'es',
  author: { '@type': 'Person', name: site.legalName, url: site.url },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.titulo,
    description: post.data.resumen,
    datePublished: post.data.fecha.toISOString(),
    url: `${site.url}/blog/${post.id}`,
  })),
};
---

<Base title={t('blog.title')} description={site.blogDescription} jsonLd={jsonLd}>
  <section class="case container" aria-labelledby="blog-title">
    <header class="case-header">
      <p class="case-eyebrow mono">
        <span class="accent">{t('blog.eyebrow')}</span>
        <a class="u-draw" href="/rss.xml">
          RSS
          <Icon class="tico" name="tabler:rss" aria-hidden="true" />
        </a>
      </p>
      <h1 class="case-title" id="blog-title">{t('blog.title')}</h1>
      <p class="case-lead">{site.blogDescription}</p>
    </header>

    {
      posts.length ? (
        <ol class="post-list">
          {posts.map((post) => (
            <li class="row row-interactive post-row">
              <a class="post-link" href={`/blog/${post.id}`}>
                <time class="post-date mono" datetime={post.data.fecha.toISOString()}>
                  {formatDate(post.data.fecha)}
                </time>
                <span class="post-main">
                  <span class="post-title">{post.data.titulo}</span>
                  <span class="post-resumen">{post.data.resumen}</span>
                  {post.data.tags.length > 0 && (
                    <span class="post-tags">
                      {post.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </span>
                  )}
                </span>
                <Icon class="post-arrow tico" name="tabler:arrow-up-right" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="section-intro">{t('blog.empty')}</p>
      )
    }
  </section>
</Base>
