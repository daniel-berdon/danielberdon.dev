---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { minutosLectura } from '../../lib/lectura';
import { useTranslations, formatDate } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.borrador)).sort(
    (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // El índice va de reciente a antiguo: el "siguiente" es el más antiguo
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { titulo, resumen, fecha, actualizado, tags } = post.data;
const { Content } = await render(post);
const minutos = minutosLectura(post.body ?? '');
const t = useTranslations();
const url = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: titulo,
      description: resumen,
      datePublished: fecha.toISOString(),
      ...(actualizado && { dateModified: actualizado.toISOString() }),
      keywords: tags.join(', '),
      inLanguage: 'es',
      mainEntityOfPage: url,
      author: { '@type': 'Person', name: site.legalName, url: site.url },
      publisher: { '@type': 'Person', name: site.legalName, url: site.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.name, item: site.url },
        { '@type': 'ListItem', position: 2, name: t('blog.title'), item: `${site.url}/blog` },
        { '@type': 'ListItem', position: 3, name: titulo, item: url },
      ],
    },
  ],
};
---

<Base title={titulo} description={resumen} ogType="article" jsonLd={jsonLd}>
  <article class="case container">
    <a class="case-back mono" href="/blog">
      <Icon class="tico" name="tabler:arrow-left" aria-hidden="true" />
      <span class="u-draw">{t('blog.back')}</span>
    </a>

    <header class="case-header">
      <p class="case-eyebrow mono">
        <time class="accent" datetime={fecha.toISOString()}>{formatDate(fecha)}</time>
        <span>{minutos} min de lectura</span>
        {actualizado && <span>{t('blog.updated')} {formatDate(actualizado)}</span>}
      </p>
      <h1 class="case-title">{titulo}</h1>
      <p class="case-lead">{resumen}</p>
      {
        tags.length > 0 && (
          <p class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="case-nav" aria-label={t('blog.more')}>
      {
        older ? (
          <a href={`/blog/${older.id}`}>
            <span class="case-nav-dir mono">
              <Icon class="tico" name="tabler:arrow-left" aria-hidden="true" />
              {t('blog.older')}
            </span>
            <span class="case-nav-title">{older.data.titulo}</span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )
      }
      {
        newer && (
          <a href={`/blog/${newer.id}`}>
            <span class="case-nav-dir mono">
              {t('blog.newer')}
              <Icon class="tico" name="tabler:arrow-right" aria-hidden="true" />
            </span>
            <span class="case-nav-title">{newer.data.titulo}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
