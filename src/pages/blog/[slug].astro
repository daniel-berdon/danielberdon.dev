---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';

export async function getStaticPaths() {
  // Español: las entradas en la raíz de la colección (id sin prefijo)
  const posts = (
    await getCollection('blog', ({ id, data }) => !data.borrador && !id.includes('/'))
  ).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // El índice va de reciente a antiguo: el "siguiente" es el más antiguo
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
---

<BlogPostPage post={post} newer={newer} older={older} lang="es" />
