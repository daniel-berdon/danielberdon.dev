---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { useTranslations, localePath, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'proyectos'>;
  lang?: Lang;
}

const { project, lang = defaultLang } = Astro.props;
const { titulo, problema, rol, stack, resultado, anio } = project.data;
const t = useTranslations(lang);
// El id es o bien «slug» (es) o «en/slug»: la ruta lleva solo el slug
const slug = project.id.split('/').pop();
---

<li class="row row-interactive project-row">
  <a class="project-link" href={localePath(lang, `/proyectos/${slug}`)}>
    <span class="project-year mono">{anio}</span>
    <span class="project-main">
      <span class="project-title">{titulo}</span>
      <span class="project-problem">{problema}</span>
      <span class="project-meta mono">
        <span>
          <span class="meta-key">{t('projects.rol')}</span>
          <span class="meta-val">{rol}</span>
        </span>
        <span>
          <span class="meta-key">{t('projects.stack')}</span>
          <span class="meta-val">{stack.join(', ')}</span>
        </span>
      </span>
    </span>
    <span class="project-side">
      <span class="project-result">
        <span class="project-result-label label">{t('projects.resultado')}</span>
        <span class="project-result-text">{resultado}</span>
      </span>
      <Icon class="project-arrow tico" name="tabler:arrow-up-right" aria-hidden="true" />
    </span>
  </a>
</li>
