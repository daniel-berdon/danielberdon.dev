---
import { site } from '../data/site';
import {
  useTranslations,
  homePath,
  localePath,
  switchLangPath,
  defaultLang,
  type Lang,
} from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const path = Astro.url.pathname;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isHome = norm(path) === norm(home);
const inProjects = path.includes('/proyectos');
const inBlog = path.includes('/blog');

// Los enlaces de sección apuntan a las anclas de la portada desde cualquier página
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);

// Selector de idioma: los slugs son idénticos, solo cambia el prefijo
const otroLang: Lang = lang === 'es' ? 'en' : 'es';
const rutaOtroLang = switchLangPath(path, otroLang);
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href={home} data-scramble>
      <span class="brand-full"><span data-scramble-text>{site.domain.replace('.dev', '')}</span><span class="brand-tld">.dev</span></span>
      <span class="brand-short"><span data-scramble-text>db</span><span class="brand-tld">—dev</span></span>
    </a>
    <nav class="site-nav" aria-label={t('nav.aria')}>
      <a href={anchor('trayectoria')} data-spy="trayectoria" data-scramble data-tone="2">
        {t('nav.trayectoria')}
      </a>
      <a
        href={anchor('trabajo')}
        data-spy="trabajo"
        data-scramble
        data-tone="3"
        aria-current={inProjects ? 'page' : undefined}
      >
        {t('nav.trabajo')}
      </a>
      <a href={anchor('contacto')} data-spy="contacto" data-scramble data-tone="5">
        {t('nav.contacto')}
      </a>
      <!-- Punto separador: los enlaces de sección a la izquierda, el blog a la derecha -->
      <span class="nav-dot" aria-hidden="true"></span>
      <a
        href={localePath(lang, '/blog')}
        aria-current={inBlog ? 'page' : undefined}
        data-scramble
        data-tone="6"
      >
        {t('nav.blog')}
      </a>
      <!-- El cambio de idioma va con recarga completa (sin view transition):
           la página de llegada repite la secuencia de arranque del sitio -->
      <a
        class="lang-switch"
        href={rutaOtroLang}
        hreflang={otroLang}
        aria-label={t('nav.lang.aria')}
        data-lang-switch
        data-astro-reload
      >
        {otroLang}
      </a>
      <ThemeToggle lang={lang} />
    </nav>
  </div>
  <div class="scroll-progress" aria-hidden="true"></div>
</header>
